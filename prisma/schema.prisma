// Base de données du site général Pandora (Plan-Site-Pandora.md §3) — distincte des bases des
// hôpitaux, auxquelles le site se connecte avec les accès enregistrés dans `Hospital`.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum AccountRole {
  ADMIN
  PROSPECTEUR
}

model Account {
  id           String      @id @default(uuid())
  email        String      @unique
  name         String
  passwordHash String
  role         AccountRole
  isActive     Boolean     @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime    @default(now())

  @@map("account")
}

// Version mobile : non souhaitée / souhaitée (à installer) / installée — renseignée par les
// prospecteurs (§9-G).
enum MobileStatus {
  NON_SOUHAITEE
  SOUHAITEE
  INSTALLEE
}

// Un hôpital client. `id` = nom d'utilisateur de sa base (unique, §3), fixé à la création.
// Le mot de passe de la base est chiffré (AES-256-GCM, clé CREDENTIALS_KEY du .env).
model Hospital {
  id            String       @id
  name          String
  dbHost        String
  dbPort        Int          @default(3306)
  dbName        String
  dbUser        String
  dbPasswordEnc String       @db.Text
  dbSsl         Boolean      @default(false)
  mobileStatus  MobileStatus @default(NON_SOUHAITEE)
  installedAt   DateTime     @default(now())
  notes         String?      @db.Text
  // Secret partagé avec l'application de l'hôpital (chiffré), pour authentifier ses appels au site
  // (paiement d'abonnement). Écrit aussi dans la base de l'hôpital (table pandora_link).
  linkSecretEnc String?      @db.Text
  // Code d'activation des postes (Plan-Code-Activation.md) : un par hôpital, réutilisable,
  // régénérable. Empreinte SHA-256 pour la recherche, version chiffrée pour le réafficher aux admins.
  activationCodeHash String?   @unique
  activationCodeEnc  String?   @db.Text
  activationCodeAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  payments      Payment[]
  devices       Device[]

  @@map("hospital")
}

// Journal des actions sur le site (qui a fait quoi).
model AuditLog {
  id        String   @id @default(uuid())
  accountId String?
  action    String
  target    String?
  detail    String?  @db.Text
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("audit_log")
}

// Demandes de contact / démo envoyées depuis la page d'accueil publique — suivies par l'équipe
// (admins et prospecteurs) dans la console.
enum ContactStatus {
  NOUVELLE
  TRAITEE
}

model ContactRequest {
  id            String        @id @default(uuid())
  name          String
  establishment String
  phone         String
  email         String?
  city          String?
  message       String?       @db.Text
  status        ContactStatus @default(NOUVELLE)
  handledById   String?
  handledAt     DateTime?
  createdAt     DateTime      @default(now())

  @@index([status, createdAt])
  @@map("contact_request")
}

// --- Abonnements (Plan-Site-Pandora.md §6) ------------------------------------------------------

// Plan de la grille (Plan-Gestion-Des-Plans.md) : carte de la page d'accueil et groupe de l'écran
// Abonnement de l'application. Nom, ordre, couleur et points forts modifiables dans la console.
// `highlights` = points forts affichés sur la page d'accueil (tableau JSON de textes).
model Plan {
  id         String      @id
  name       String
  color      String      @default("emerald")
  highlights String      @db.Text
  comingSoon Boolean     @default(false)
  active     Boolean     @default(true)
  sortOrder  Int         @default(0)
  items      PriceItem[]

  @@map("plan")
}

// Élément facturable d'un plan : un forfait (ex. Gestion financière = Caisse + Comptabilité) ou
// un module vendu à l'unité (ex. Laboratoire). `modules` = identifiants de modules de l'application.
// `key` ne change jamais : il figure dans les abonnements signés.
model PriceItem {
  key       String  @id
  planId    String
  plan      Plan    @relation(fields: [planId], references: [id])
  label     String
  price     Int
  modules   String  @db.Text
  mandatory Boolean @default(false)
  active    Boolean @default(true)
  sortOrder Int     @default(0)

  @@index([planId])
  @@map("price_item")
}

// Règle de réduction de l'abonnement (Plan-Reductions-Abonnement.md §8) : une portée (`planIds`,
// liste JSON des sections ; vide = tout l'abonnement) et ses paliers.
model DiscountRule {
  id        String         @id
  planIds   String         @default("[]") @db.VarChar(2000)
  sortOrder Int            @default(0)
  updatedAt DateTime       @updatedAt
  tiers     DiscountTier[]

  @@map("discount_rule")
}

// Palier d'une règle : à partir de `minItems` éléments payants choisis dans sa portée, `percent` %
// de moins sur ces éléments.
model DiscountTier {
  ruleId    String
  rule      DiscountRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  minItems  Int
  percent   Int
  updatedAt DateTime     @updatedAt

  @@id([ruleId, minItems])
  @@map("discount_tier")
}

enum PaymentMethod {
  MONEYFUSION
  MANUEL
}

enum PaymentStatus {
  EN_ATTENTE
  PAYE
  APPLIQUE
  ECHEC
  ANNULE
}

// Un paiement d'abonnement : MoneyFusion (depuis l'application de l'hôpital) ou saisi à la main
// par un admin. `items`/`modules` = sélection complète souhaitée ; appliqué une seule fois.
model Payment {
  id                String        @id @default(uuid())
  hospitalId        String
  hospital          Hospital      @relation(fields: [hospitalId], references: [id])
  method            PaymentMethod
  status            PaymentStatus @default(EN_ATTENTE)
  items             String        @db.Text
  modules           String        @db.Text
  months            Int
  amount            Int
  prorataAmount     Int           @default(0)
  // Réduction selon le nombre d'éléments (Plan-Reductions-Abonnement.md), déjà déduite de `amount`.
  discountPercent   Int           @default(0)
  discountAmount    Int           @default(0)
  previousEndDate   String?
  newEndDate        String?
  moneyfusionToken  String?       @unique
  moneyfusionUrl    String?       @db.Text
  payerName         String?
  payerPhone        String?
  transactionNumber String?
  paymentMeans      String?
  note              String?       @db.Text
  recordedById      String?
  events            String?       @db.Text
  lastError         String?       @db.Text
  createdAt         DateTime      @default(now())
  paidAt            DateTime?
  appliedAt         DateTime?

  @@index([hospitalId, createdAt])
  @@index([status])
  @@map("payment")
}

// Poste activé avec le code d'activation de son hôpital. Le jeton (seule son empreinte est gardée)
// permet au poste de récupérer les accès à jour de la base ; un poste révoqué n'y a plus droit.
model Device {
  id         String    @id @default(uuid())
  hospitalId String
  hospital   Hospital  @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  name       String
  tokenHash  String    @unique
  appVersion String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?

  @@index([hospitalId])
  @@map("device")
}
