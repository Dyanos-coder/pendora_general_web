## Base de données du site Pandora (MySQL/MariaDB)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=pandora_web
DB_USER=user
DB_PASSWORD=password

## Secret de signature des sessions (cookie) — valeur aléatoire longue :
##   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=change-me

## Clé de chiffrement des mots de passe des bases des hôpitaux (32 octets en base64) :
##   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
## ⚠️ Ne jamais la perdre ni la changer : les mots de passe enregistrés deviendraient illisibles.
CREDENTIALS_KEY=

## Adresse publique du site (retours MoneyFusion, QR codes des reçus) — à renseigner à l'hébergement.
## Elle est aussi écrite dans la base de chaque hôpital (table pandora_link) : c'est par elle que
## l'application des hôpitaux joint le site pour payer l'abonnement.
SITE_URL=http://localhost:3000

## MoneyFusion (étape 5) : URL d'API marchand (création des paiements), fournie dans le tableau de bord
## MoneyFusion. Pas de secret webhook : chaque notification est revérifiée auprès de MoneyFusion.
MONEYFUSION_API_URL=

## Clé privée Ed25519 de signature des abonnements (§6.4) — l'application des hôpitaux contient la
## clé publique correspondante. Générée une seule fois ; ne jamais la divulguer ni la changer
## (les abonnements déjà signés deviendraient invalides).
SUBSCRIPTION_PRIVATE_KEY=
